# Copy to .env and replace the values. Never commit .env.
# The app reads DATABASE_URL from the environment or from .env.
# Use the psycopg v3 driver prefix. Do not put real production passwords in this file.

# Host process: uvicorn on this machine, PostgreSQL on localhost.
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER@localhost:5432/customer_platform
LOG_LEVEL=INFO

# Browser origins allowed to call this API. Comma-separated. A wildcard is rejected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Docker Compose. These are local defaults, not production secrets.
# Compose passes the password as POSTGRES_PASSWORD. It does not place that
# password into DATABASE_URL, and it does not pass the host DATABASE_URL into
# the containers. The application builds the container URL with SQLAlchemy and
# points it at the hostname postgres, so characters such as @, :, /, #, and %
# in the password are encoded.
POSTGRES_USER=customer
POSTGRES_PASSWORD=customer_dev_password
POSTGRES_DB=customer_platform
